[test]
repo_path = "/root/OpenDS"    # Where scripts/rsync.py lands the tree on the target.
build_dir = "/tmp/opends-build"
nvme_bdf = "CHANGE_ME"        # PCI BDF of NVMe device (lspci -D -d ::0108). bind/mount scripts resolve the /dev/nvmeXnY name from sysfs.
mount_point = "CHANGE_ME"     # Where the NVMe namespace is mounted (e.g. /mnt/datasets). Tests write only into <mount>/opends_tests/.
