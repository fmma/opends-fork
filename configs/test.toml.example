[test]
repo_path = "/root/OpenDS"    # Where scripts/rsync.py lands the tree on the target.
build_dir = "/tmp/opends-build"
nvme_bdf = "CHANGE_ME"        # PCI BDF of NVMe device (lspci -D -d ::0108)
nvme_ns = "CHANGE_ME"         # NVMe namespace device (e.g. /dev/nvme0n1)
mount_point = "/mnt/datasets" # Where the NVMe namespace is mounted; the test writes only into <mount>/opends_tests/.
